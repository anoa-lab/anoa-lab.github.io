@inproceedings{fang_enabling_2026,
	location = {Chicago},
	title = {Enabling Reactor Monitoring through Ex-Core Neutron Detection},
	rights = {All rights reserved},
	abstract = {Realizing the market potential for small modular reactors ({SMRs}) across a broad range of enduse applications will require a paradigm shift in reactor monitoring and control. In-core detectors designed for current light water reactors ({LWRs}) may not be suitable for {SMRs}. Detector motion will be infeasible in modular designs and, for some designs, in-core instrumentation needs to withstand operating temperatures up to 1600 ◦C. In this work, we demonstrated the feasibility of monitoring the in-core neutron flux distribution in {SMRs} with ex-core neutron detectors. The in-core neutron flux was reconstructed by inverting the system response matrix that relates the simulated detector response to a unit-flux source in the core to the measured detector counts. We validated this methodology through an experimental campaign at the Ohio State University Research Reactor ({OSURR}), which contains 19 fuel assemblies and 4 control rod assemblies. Neutron counts were measured at 18 detector positions. A Serpent model of the {OSURR} was developed to simulate the system response matrix. Reconstruction on simulated data showed agreement with the ground truth within 0.1\% relative error, validating the reconstruction algorithm. We applied the validated reconstruction algorithm to the measured data, and obtained the flux peak at the expected fuel assembly position. The proposed detection system enables in-core flux reconstruction without inserting or moving detectors within the core, which will increase the level of operation automation for emerging microreactor technologies. While {SMRs} would particularly benefit from this technology, it will broadly apply to the current and advanced reactor designs.},
	eventtitle = {Global 2026},
	pages = {326--332},
	publisher = {{ANS}},
	author = {Fang, Ming and Lee, Alvin and Beaumont, Bruce and Chaube, Anshuman and Ardiansyah, Harun and Harvis, Keenan and Grunloh, Timothy and Brooks, Caleb and Kozlowski, Tomasz and Fulvio, Angela Di},
  	year = {2026},
	langid = {english},
	published={1},
	tag = {},
}

@inproceedings{ardiansyah_novel_2026,
	title = {Novel Neutron Noise Unfolding Methods and Applications for Anomaly Detection in 2D {HTTR} Core},
	rights = {Creative Commons Attribution 4.0 International},
	url = {https://zenodo.org/doi/10.5281/zenodo.20803920},
	doi = {10.5281/ZENODO.20803920},
	abstract = {This paper introduces new neutron noise unfolding method based on Green’s function called the greedy method. Neutron noise unfolding methods are the methods used to determine the magnitude, location, energy, and frequency of neutron noise sources. The challenge of neutron noise unfolding is that neutron noise is not known at all positions and neutron energy. It is only known at the detector positions. The greedy method iterates Green’s function to find the Green’s function matrix and the local minimum of the residual. This results in several valid solutions to the noise sources. The correct solution is the one that requires the least number of Green’s function combinations to minimize the residual. The method is compared with the scanning method, which is the standard method. The scanning method minimizes the ratio of neutron noise and the Green’s function at two different detector locations. This is done iteratively for all combinations of two detectors. Both methods are applied to unfold noise sources in 2D {HTTR} core. The noise sources are defined as absorber of variable strength ({AVS}) type noise sources. The results indicate that the scanning method shows satisfactory results but is limited to only one {AVS}-type source. For the greedy method, the results show that the greedy method is able to unfold multiple neutron noise sources simultaneously.},
	eventtitle = {The International Conference on Physics of Reactors ({PHYSOR}) 2026},
	booktitle = {Proceeding of {PHYSOR} 2026},
	publisher = {Politecnico di Torino},
	author = {Ardiansyah, Harun and Kozłowski, Tomasz},
	urldate = {2026-06-30},
  	year = {2026},
	langid = {english},
	published={1},
	tag = {10001},
	grant = {},
	keywords = {conference paper, {PHYSOR} 2026, S08. Methods and Techniques for Neutron Noise Analysis},
}

@article{ardiansyah_review_2026,
	title = {Review of Detecting Anomalies in Power Reactors Using Neutron Noise Analysis},
	rights = {All rights reserved},
	issn = {0029-5450, 1943-7471},
	url = {https://www.tandfonline.com/doi/full/10.1080/00295450.2026.2619208},
	doi = {10.1080/00295450.2026.2619208},
	abstract = {Core diagnostics has been a key component of nuclear reactor operation to ensure reactor safety and performance. As a multicomponent system, perturbations in nuclear reactors are unavoidable. This article reviews neutron noise, and its definition and application to nuclear reactors. Our review finds that neutron noise has been integral to nuclear reactor operations. Multiple experiments using reactor data have been conducted to measure the perturbations that can happen to a nuclear reactor. Implementation of neutron noise analysis provides some insight into the perturbations that can happen in a reactor, effectively providing a means to diagnose all the phenomena in a nuclear reactor system.},
	pages = {1--22},
	published={1},
	tag = {10001},
	grant = {},
	journaltitle = {Nuclear Technology},
	shortjournal = {Nuclear Technology},
	author = {Ardiansyah, Harun and Kozlowski, Tomasz},
	urldate = {2026-03-27},
	year = {2026},
	langid = {english},
}

