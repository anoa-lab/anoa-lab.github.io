@inproceedings{fang_reconstruct_2025,
	location = {Chicago},
	title = {Reconstruct In-core Neutron Flux Distribution Using Ex-Core Detectors},
	abstract = {Realizing the market potential for small modular reactors ({SMRs}), across the wide breadth of proposed end-use applications, will require a paradigm shift in reactor monitoring and control. In-core detectors in the current reactor fleet optimized for {LWR} applications may not be suitable for {SMRs}. Detector motion will not be possible at modular reactors, and in-core instrumentation needs to withstand operating temperatures up to 650 ◦C. To address these concerns, we explored the possibility of monitoring the in-core neutron flux distribution in {SMRs} with ex-core neutron detectors. We simulated a 20-{MWth} {SMR} with 36 fuel assemblies in {MNCP}6. An array of 60 neutron detectors were placed ex-core with an angular resolution 6◦ and axial resolution of 16 cm to measure the neutron flux at steady state. On the other hand, we simulated the detector response with only one assembly in the core capable of undergoing fission and obtained a system response matrix by iterating over all fuel assemblies. We then reconstructed the in-core neutron flux distribution by solving a linear inverse problem with the Fast Iterative {ShrinkageThresholding} Algorithm ({FISTA}) solver. Our reconstruction algorithm achieved a relative error of 3\% in integral neutron flux, compared to the flux simulated with {MCNP}, with axial variation of neutron flux present. This shows promise of employing ex-core neutron detectors to measure the in-core neutron flux distribution in a {SMR}. We are working on optimizing the number of detectors to enhance the practicality of the proposed monitoring methodology.},
	eventtitle = {Nuclear Plant Instrumentation and Control \& Human-Machine Interface Technology ({NPIC}\&{HMIT} 2025)},
	pages = {1288--1294},
	booktitle = {Conference of {NPIC}\&{HMIT} 2025},
	publisher = {American Nuclear Society},
	author = {Fang, Ming and Chaube, Anshuman and Ardiansyah, Harun and Harvis, Keenan and Grunloh, Timothy and Brooks, Caleb and Kozlowski, Tomasz and Fulvio, Angela Di},
	year = {2025},
	published={1},
	tag = {},
	grant = {},
	langid = {english},
}

@article{dwijayanto_verification_2024,
	title = {Verification and Geometry Optimization of a One Fluid Molten Salt Reactor With Fixed Volume},
	volume = {10},
	rights = {All rights reserved},
	issn = {2332-8983, 2332-8975},
	url = {https://asmedigitalcollection.asme.org/nuclearengineering/article/10/3/031301/1193943/Verification-and-Geometry-Optimization-of-a-One},
	doi = {10.1115/1.4064465},
	abstract = {Thermal molten salt reactors can be designed in many configurations. This paper investigates the optimal geometry of a one fluid molten salt reactor ({OFMSR}) in a virtual one-and-half fluid configuration with a fixed fuel salt volume. Two primary configurations were studied, axial blanket (three models) and radial blanket (two models). Neutronic calculations were performed using Monte Carlo N-particle 6.2 ({MCNP}6.2) and Serpent-2 reactor physics codes with evaluated nuclear data files/B-{VII}.0 continuous neutron library. The analysis comprises criticality calculation, temperature coefficient of reactivity ({TCR}), breeding ratio ({BR}), and kinetic parameters. The results imply a good agreement between {MCNP} and Serpent calculations. {TCR} values show a different pattern between axial and radial blanket configuration. While the correlation between {TCR} and {BR} is inversely correlated in axial blanket, it is linear in radial blanket configuration. Overall, radial blanket configuration seemed to show better neutronic performance than axial blanket configuration, with comparably strong negative {TCR} and large {BR}.},
	pages = {031301},
	number = {3},
	journaltitle = {Journal of Nuclear Engineering and Radiation Science},
	author = {Dwijayanto, R. Andika Putra and Ardiansyah, Harun and Harto, Andang Widi},
	urldate = {2024-04-18},
	year = {2024},
	published={1},
	tag = {10002},
	grant = {},
	langid = {english},
}

